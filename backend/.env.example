# Copy to .env and fill in the password. Only DATABASE_URL is required; the rest have defaults.
DATABASE_URL=postgresql://acadmate:CHANGE_ME@localhost:5433/acadmate

# Separate database for pytest (tests drop and recreate every table in it).
# Create once: docker exec acadmate-fastapi-db createdb -U acadmate acadmate_test
TEST_DATABASE_URL=postgresql://acadmate:CHANGE_ME@localhost:5433/acadmate_test

# Session cookie name, and how long "Keep me signed in" lasts (days).
SESSION_COOKIE=acadmate_session
SESSION_DAYS_REMEMBER=30

# Encrypts integration secrets (spec 35). Any long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# true enables POST /admin/demo/reset (spec 37).
DEMO_MODE=false

# true in production (HTTPS only cookies).
COOKIE_SECURE=false

# Frontend origin allowed by CORS (direct calls; the Vite proxy doesn't need it).
FRONTEND_ORIGIN=http://localhost:5173

# Google sign-in (spec 02, optional) and the Google Calendar integration (spec 35).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=

# Outlook Calendar integration (spec 35, optional). Empty → Connect says it isn't configured.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Claude for the AI advisor (spec 13). Empty → rule-based answers.
ANTHROPIC_API_KEY=

# Pins "today" for demo data, e.g. 2026-10-01. Empty → the real date.
ACADMATE_TODAY=

# Public base URL for calendar feed links (spec 14), e.g. https://api.example.edu. Empty → the request's URL.
PUBLIC_API_URL=
