# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend, used in reset/invite links and Google sign-in redirects
APP_URL=http://localhost:5173
# Public URL of this API, used for the Google OAuth callback
API_URL=http://localhost:4000
# Set to true when running behind a reverse proxy (so client IPs and secure cookies work)
TRUST_PROXY=false
LOG_LEVEL=info

# --- Database (docker compose reads POSTGRES_* too) ---
POSTGRES_USER=acadmate
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_DB=acadmate
POSTGRES_PORT=5432
DATABASE_URL=postgres://acadmate:change-me-local-password@localhost:5432/acadmate
# Used only by `npm test`; the test suite wipes and re-seeds this database
TEST_DATABASE_URL=postgres://acadmate:change-me-local-password@localhost:5432/acadmate_test

# --- Seed data ---
# Password given to every demo account created by `npm run seed` (min 8 chars)
SEED_PASSWORD=
# Allow admins to wipe and re-seed the database from Admin > Settings (never enable in production)
ALLOW_DEMO_RESET=false

# --- Google sign-in (optional; leave blank to disable) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional; if SMTP_HOST is blank, emails are printed to the server log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Acadmate <no-reply@school.edu>"

# --- AI advisor (optional; leave the key blank to use rule-based answers only) ---
# With a key set, student questions and the student's academic data needed to answer them are sent to
# Anthropic's API. Get approval before using real student records (FERPA).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high: how much reasoning Claude spends per answer (higher costs more)
AI_EFFORT=medium
AI_TIMEOUT_MS=60000
