# Copy to .env.local to override. Both values have working defaults for local development.

# Where the browser sends API requests.
#   /api (default)               -> through the Vite dev-server proxy below (same origin, no CORS)
#   http://localhost:4000/api    -> straight to the API; add this site's origin to CORS_ORIGINS in backend/.env
VITE_API_URL=/api

# Where the Vite dev server forwards /api requests (dev only, not exposed to the browser).
API_PROXY_TARGET=http://localhost:4000
